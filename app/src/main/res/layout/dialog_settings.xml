<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 標題區塊 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="0dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="設定"
                android:textSize="18dp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseDialog"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="關閉" />
        </RelativeLayout>

        <!-- 偵測靈敏度 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:text="偵測靈敏度"
            android:textSize="14dp" />

        <RadioGroup
            android:id="@+id/radioGroupSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/radioLow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@drawable/radio_gradient"
                android:text="低"
                android:textSize="12dp"
                android:padding="8dp" />


            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/radioMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@drawable/radio_gradient"
                android:text="中"
                android:textSize="12dp"
                android:padding="8dp" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/radioHigh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@drawable/radio_gradient"
                android:text="高"
                android:textSize="12dp"
                android:padding="8dp" />
        </RadioGroup>

        <!-- 提醒方式 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:text="提醒方式"
            android:textSize="14dp" />

        <!-- 語音提醒 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12dp"
                android:text="語音" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/switch_thumb_gradient"
                android:track="@drawable/switch_track_gradient" />
        </LinearLayout>

        <!-- 震動提醒 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="0dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12dp"
                android:text="震動" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchVibration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/switch_thumb_gradient"
                android:track="@drawable/switch_track_gradient" />
        </LinearLayout>

        <!-- 儲存與登出按鈕 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/gradient_button"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="儲存"
            android:textColor="#FFFFFF"
            android:textSize="14dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/gradient_button"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="登出"
            android:textColor="#FFFFFF"
            android:textSize="14dp" />

    </LinearLayout>
</ScrollView>
